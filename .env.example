# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Приватный канал-хранилище платформы.
# Создай канал, добавь туда бота админом с правом публикации,
# перешли любое сообщение из него боту @getmyid_bot и возьми id (вида -1001234567890)
STORAGE_CHANNEL_ID=-1001234567890

# Публичный https-адрес мини-аппа (для локальной разработки — туннель, например `cloudflared tunnel --url http://localhost:5173`)
WEBAPP_URL=https://example.trycloudflare.com

# Загрузка по ссылке. Нужны yt-dlp и ffmpeg; в Docker-образе они уже есть,
# локально — brew install yt-dlp ffmpeg. Без них импорт работает, но только
# подбором по общему каталогу: качать будет нечем.
YTDLP_PATH=yt-dlp
DOWNLOAD_MAX_MB=45
DOWNLOAD_MAX_SECONDS=1800
DOWNLOAD_TIMEOUT_MS=240000
DOWNLOAD_MAX_ITEMS=50

# Служебное
PORT=8787
DATABASE_PATH=./telemusic.db
